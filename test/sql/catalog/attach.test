# name: test/sql/catalog/attach.test
# description: Catalog ATTACH, DETACH, re-attach, and secret-based attach
# group: [catalog]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

# Inline ATTACH
statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# Catalog appears in duckdb_databases()
query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'lake';
----
1

# Query works after attach
query I
SELECT count(*) FROM lake.default.test_table;
----
5

# DETACH removes the catalog
statement ok
DETACH lake;

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'lake';
----
0

# Re-attach after detach
statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

query I
SELECT count(*) FROM lake.default.test_table;
----
5

statement ok
DETACH lake;

# DuckDB's generic ATTACH options are accepted alongside ours, and option names are case-insensitive
statement ok
ATTACH '' AS lake (TYPE ICEBERG, Endpoint 'http://localhost:8181', READONLY);

query I
SELECT readonly FROM duckdb_databases() WHERE database_name = 'lake';
----
true

query I
SELECT count(*) FROM lake.default.test_table;
----
5

statement ok
DETACH lake;

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181', READ_WRITE false);

query I
SELECT readonly FROM duckdb_databases() WHERE database_name = 'lake';
----
true

statement ok
DETACH lake;

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181', DEFAULT_TABLE 'default.test_table');

query I
SELECT count(*) FROM lake;
----
5

statement ok
DETACH lake;

statement error
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181', NOT_AN_OPTION 'x');
----
Unrecognized ATTACH option: 'not_an_option'

# ATTACH OR REPLACE always reconnects, so a changed ENDPOINT is re-validated
statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

statement error
ATTACH OR REPLACE '' AS lake (TYPE ICEBERG, ENDPOINT 'http://127.0.0.1:1');
----
Failed to create Iceberg REST catalog

statement ok
DETACH lake;

# Secret-based attach
statement ok
CREATE SECRET ic_secret (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

statement ok
ATTACH '' AS lake (TYPE ICEBERG);

query I
SELECT count(*) FROM lake.default.test_table;
----
5

statement ok
DETACH lake;

statement ok
DROP SECRET ic_secret;

# ATTACH with no endpoint and no secret fails
statement error
ATTACH '' AS lake (TYPE ICEBERG);
----
Missing 'endpoint' option for Iceberg attach

# ATTACH against a bad endpoint fails at attach time.
statement error
ATTACH '' AS bad_lake (TYPE ICEBERG, ENDPOINT 'http://127.0.0.1:1');
----
Failed to create Iceberg REST catalog
