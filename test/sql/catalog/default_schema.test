# name: test/sql/catalog/default_schema.test
# description: Default schema resolution: implicit "default" fallback and explicit DEFAULT_SCHEMA option
# group: [catalog]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

# --- Without DEFAULT_SCHEMA: falls back to "default" namespace ---

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# Unqualified table resolves to 'default' namespace
query I
SELECT count(*) FROM lake.test_table;
----
5

# DuckDB's "main" schema redirects to "default" namespace
query I
SELECT count(*) FROM lake.main.test_table;
----
5

# Multi-level Iceberg namespaces are not supported and must not be flattened to the last component.
statement ok
USE lake;

statement error
SELECT count(*) FROM foo.default.test_table;
----
does not exist

statement error
SHOW TABLES FROM foo.default;
----
No catalog + schema

statement error
USE foo.default;
----
No catalog + schema

statement ok
USE memory.main;

statement ok
DETACH lake;

# --- With DEFAULT_SCHEMA 'testing': overrides the fallback ---

# Attach with default_schema pointed at 'testing' (not 'default')
statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181', DEFAULT_SCHEMA 'testing');

# Fully qualified query against 'testing' works
query IT
SELECT id, value FROM lake.testing.sample ORDER BY id;
----
1	x
2	y
3	z

# Unqualified schema resolves to 'testing' via default_schema
query IT
SELECT id, value FROM lake.sample ORDER BY id;
----
1	x
2	y
3	z

# DuckDB's "main" schema redirects to configured default_schema ('testing'), not 'default'
query IT
SELECT id, value FROM lake.main.sample ORDER BY id;
----
1	x
2	y
3	z

# Tables in 'default' namespace are still reachable with explicit qualification
query I
SELECT count(*) FROM lake.default.test_table;
----
5

# But 'default' tables are NOT found via unqualified lookup as default_schema is 'testing'
statement error
SELECT * FROM lake.test_table;
----
does not exist

statement ok
DETACH lake;

# --- Configured namespaces retain their case ---

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181', DEFAULT_SCHEMA 'MAIN');

# DuckDB's lowercase "main" schema redirects to the uppercase Iceberg namespace without folding its case.
statement ok
CALL enable_logging(level := 'debug');

statement ok
CALL truncate_duckdb_logs();

statement error
SELECT * FROM lake.main.case_sensitive_missing;
----
does not exist

query I
SELECT count(*) FROM duckdb_logs() WHERE message LIKE '%LoadTable ''MAIN.case_sensitive_missing''%';
----
1

statement ok
DETACH lake;
