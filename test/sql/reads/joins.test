# name: test/sql/reads/joins.test
# description: Joins across Iceberg tables
# group: [reads]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# Inner join (customer_id=4 has no match in customers)
query ITTR
SELECT o.order_id, c.name, c.city, o.total
FROM lake.default.orders o
JOIN lake.default.customers c ON o.customer_id = c.customer_id
ORDER BY o.order_id;
----
101	Alice	New York	150.0
102	Bob	London	250.5
103	Alice	New York	75.25
104	Charlie	Tokyo	320.0
105	Bob	London	180.75

# Left join surfaces the unmatched order
query IIT
SELECT o.order_id, o.customer_id, c.name
FROM lake.default.orders o
LEFT JOIN lake.default.customers c ON o.customer_id = c.customer_id
ORDER BY o.order_id;
----
101	1	Alice
102	2	Bob
103	1	Alice
104	3	Charlie
105	2	Bob
106	4	NULL

query TIR
SELECT c.name, count(*), round(sum(o.total), 2)
FROM lake.default.orders o
JOIN lake.default.customers c ON o.customer_id = c.customer_id
GROUP BY c.name
ORDER BY sum(o.total) DESC;
----
Bob	2	431.25
Charlie	1	320.0
Alice	2	225.25

# Subquery: orders from London customers
query IITR
SELECT * FROM lake.default.orders
WHERE customer_id IN (
    SELECT customer_id FROM lake.default.customers WHERE city = 'London'
)
ORDER BY order_id;
----
102	2	2024-01-15	250.5
105	2	2024-03-01	180.75
