# name: test/sql/reads/nan.test
# description: Filters on FLOAT/DOUBLE columns keep DuckDB's NaN semantics (NaN = NaN, NaN sorts above all values)
# group: [reads]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CALL enable_logging(level := 'debug');

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# nan_values: f (FLOAT) and d (DOUBLE) hold the same values, one file per group:
#   ids 1-2: NaN
#   ids 3-5: NaN, 1.0, 2.0 (min/max statistics exclude NaN, so bounds are [1.0, 2.0])
#   ids 6-9: 10.0, 20.0, 30.0, NULL

query I
SELECT count(*) FROM lake.default.nan_values;
----
9

# Pruning is live on this data: d < 5 skips the 10.0-30.0 file.
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d < 5;
----
[4, 5]

query I
SELECT count(*) FROM (SELECT DISTINCT 1 FROM duckdb_logs()
  WHERE message LIKE 'proto_iceberg: planned 2 data file(s) for ''default.nan_values''%');
----
1

# DOUBLE: NaN sorts above every other value, so > and >= also match NaN, including the NaN in the file whose bounds
# lie below the constant.

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d > 5;
----
[1, 2, 3, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d >= 10;
----
[1, 2, 3, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d < 5;
----
[4, 5]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d <= 2;
----
[4, 5]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d = 1;
----
[4]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d <> 1;
----
[1, 2, 3, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d IN (2, 20);
----
[5, 7]

# DOUBLE: NaN constants. NaN = NaN, and nothing is greater than NaN.

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d = 'NaN'::DOUBLE;
----
[1, 2, 3]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d <> 'NaN'::DOUBLE;
----
[4, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d > 'NaN'::DOUBLE;
----
NULL

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d >= 'NaN'::DOUBLE;
----
[1, 2, 3]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d < 'NaN'::DOUBLE;
----
[4, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d <= 'NaN'::DOUBLE;
----
[1, 2, 3, 4, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE d IN (10, 'NaN'::DOUBLE);
----
[1, 2, 3, 6]

# FLOAT: NaN sorts above every other value, so > and >= also match NaN, including the NaN in the file whose bounds
# lie below the constant.

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f > 5;
----
[1, 2, 3, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f >= 10;
----
[1, 2, 3, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f < 5;
----
[4, 5]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f <= 2;
----
[4, 5]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f = 1;
----
[4]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f <> 1;
----
[1, 2, 3, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f IN (2, 20);
----
[5, 7]

# FLOAT: NaN constants. NaN = NaN, and nothing is greater than NaN.

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f = 'NaN'::FLOAT;
----
[1, 2, 3]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f <> 'NaN'::FLOAT;
----
[4, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f > 'NaN'::FLOAT;
----
NULL

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f >= 'NaN'::FLOAT;
----
[1, 2, 3]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f < 'NaN'::FLOAT;
----
[4, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f <= 'NaN'::FLOAT;
----
[1, 2, 3, 4, 5, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.default.nan_values WHERE f IN (10, 'NaN'::FLOAT);
----
[1, 2, 3, 6]
