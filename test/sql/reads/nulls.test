# name: test/sql/reads/nulls.test
# description: NULL handling in Iceberg tables
# group: [reads]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

query ITRI
SELECT * FROM lake.default.nullable_table ORDER BY id;
----
1	Alice	95.5	true
2	NULL	87.3	false
3	Charlie	NULL	true
4	NULL	NULL	NULL
5	Eve	72.1	NULL
6	Frank	88.0	false

query I
SELECT id FROM lake.default.nullable_table WHERE name IS NULL ORDER BY id;
----
2
4

query IR
SELECT id, score FROM lake.default.nullable_table WHERE score IS NOT NULL ORDER BY id;
----
1	95.5
2	87.3
5	72.1
6	88.0

query IT
SELECT id, COALESCE(name, 'UNKNOWN') FROM lake.default.nullable_table ORDER BY id;
----
1	Alice
2	UNKNOWN
3	Charlie
4	UNKNOWN
5	Eve
6	Frank

query III
SELECT count(*), count(name), count(score) FROM lake.default.nullable_table;
----
6	4	4
