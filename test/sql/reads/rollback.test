# name: test/sql/reads/rollback.test
# description: Table rollback
# group: [reads]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# Only batch1 data is visible after rollback
query IT
SELECT * FROM lake.default.rollback_table ORDER BY id;
----
1	a
2	b
3	c

# Count confirms only 3 rows (not 6)
query I
SELECT count(*) FROM lake.default.rollback_table;
----
3
