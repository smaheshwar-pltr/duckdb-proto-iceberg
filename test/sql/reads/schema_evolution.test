# name: test/sql/reads/schema_evolution.test
# description: Reads on schema-evolved, delicate tables
# group: [reads]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# Column 'details' renamed to 'description'. Data written before and after the rename.

query TTTTTT
DESCRIBE lake.default.schema_evolution;
----
id	INTEGER	YES	NULL	NULL	NULL
description	VARCHAR	YES	NULL	NULL	NULL

query IT
SELECT id, description FROM lake.default.schema_evolution ORDER BY id;
----
1	original-one
2	original-two
3	original-three
4	renamed-four
5	renamed-five
6	renamed-six

# Column 'old_name' renamed to 'new_name' but no new data was written.

query TTTTTT
DESCRIBE lake.default.pinned_schema;
----
id	INTEGER	YES	NULL	NULL	NULL
new_name	VARCHAR	YES	NULL	NULL	NULL

query IT
SELECT * FROM lake.default.pinned_schema ORDER BY id;
----
1	alpha
2	beta
3	gamma

query IT
SELECT * FROM lake.default.pinned_schema WHERE new_name = 'alpha';
----
1	alpha

query I
SELECT count(*) FROM lake.default.pinned_schema WHERE new_name = 'nonexistent';
----
0

# Old Parquet files lack 'extra'; NULL-filled under the current schema.

query TTTTTT
DESCRIBE lake.default.add_column;
----
id	INTEGER	YES	NULL	NULL	NULL
name	VARCHAR	YES	NULL	NULL	NULL
extra	INTEGER	YES	NULL	NULL	NULL

query ITI
SELECT id, name, extra FROM lake.default.add_column ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	NULL
4	d	40
5	e	50
6	f	60

query ITI
SELECT id, name, extra FROM lake.default.add_column WHERE extra >= 50 ORDER BY id;
----
5	e	50
6	f	60

query I
SELECT count(*) FROM lake.default.add_column WHERE extra IS NULL;
----
3

# 'obsolete' is gone from the current schema; reads must not surface it.

query TTTTTT
DESCRIBE lake.default.drop_column;
----
id	INTEGER	YES	NULL	NULL	NULL
name	VARCHAR	YES	NULL	NULL	NULL

query IT
SELECT id, name FROM lake.default.drop_column ORDER BY id;
----
1	a
2	b
3	c
4	d
5	e
6	f

query IT
SELECT id, name FROM lake.default.drop_column WHERE name = 'a';
----
1	a
