# name: test/sql/reads/time.test
# description: TIME type scanning
# group: [reads]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

query TTTTTT
DESCRIBE lake.default.time_table;
----
id	INTEGER	YES	NULL	NULL	NULL
col_time	TIME	YES	NULL	NULL	NULL

query IT
SELECT id, col_time FROM lake.default.time_table ORDER BY id;
----
1	00:00:00
2	12:30:15
3	23:59:59.123456

query I
SELECT id FROM lake.default.time_table WHERE col_time = TIME '12:30:15';
----
2
