# name: test/sql/reads/time_travel.test
# description: AT clauses are rejected
# group: [reads]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# A normal scan works.
query I
SELECT count(*) FROM lake.default.test_table;
----
5

statement error
SELECT * FROM lake.default.test_table AT (VERSION => 1);
----
does not support time travel

statement error
SELECT * FROM lake.default.test_table AT (TIMESTAMP => TIMESTAMP '2024-01-01 00:00:00');
----
does not support time travel
