# name: test/sql/transactions/concurrent.test
# description: Concurrent reads across threads
# group: [transactions]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# Each autocommit query runs in a new transaction, which lists and loads tables anew, so calls from different
# connections into the shared REST catalog overlap.
concurrentloop threadid 0 16

loop i 0 4

query TTT
SELECT database, schema, name FROM (SHOW ALL TABLES)
WHERE database = 'lake' AND name IN ('test_table', 'sample')
ORDER BY schema, name;
----
lake	default	test_table
lake	testing	sample

query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM lake.default.all_types;
----
3

query I
SELECT count(*) FROM lake.default.nested_types;
----
4

endloop

endloop
