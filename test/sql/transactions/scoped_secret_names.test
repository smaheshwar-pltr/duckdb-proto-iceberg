# name: test/sql/transactions/scoped_secret_names.test
# description: Scoped S3 secrets are unique per attached catalog and table, and dropped when the transaction ends
# group: [transactions]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

# A table read without its own secret fails with an HTTP error, which must fail this test rather than skip it.
set ignore_error_messages

statement ok
CREATE SECRET s3_base (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake1 (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

statement ok
ATTACH '' AS lake2 (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# Two catalogs attached to the same endpoint each create their own secret for a same-named table.
statement ok
BEGIN;

query I
SELECT count(*) FROM lake1.default.test_table;
----
5

query I
SELECT count(*) FROM lake2.default.test_table;
----
5

query II
SELECT count(*), count(DISTINCT name) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
2	2

query II
SELECT count(*) FILTER (WHERE name LIKE '%lake1%'), count(*) FILTER (WHERE name LIKE '%lake2%')
FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
1	1

# Scanning again reuses each catalog's secret.
query I
SELECT count(*) FROM lake1.default.test_table;
----
5

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
2

# Both secrets are dropped on commit, even though the second catalog's transaction commits before the system catalog's
# transaction that created them.
statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# Tables whose namespace and name join to the same string with an underscore each create their own secret.
statement ok
BEGIN;

query I
SELECT count(*) FROM lake1.default.split_name;
----
1

query I
SELECT count(*) FROM lake1.default_split.name;
----
2

query II
SELECT count(*), count(DISTINCT name) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
2	2

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# A secret is created in its connection's transaction, so other connections don't see it until that transaction ends.
statement ok con1
BEGIN;

query I con1
SELECT count(*) FROM lake1.default.test_table;
----
5

query I con1
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
1

query I con2
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

statement ok con1
COMMIT;

query I con2
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0
