# name: test/sql/transactions/secret_cleanup.test
# description: Vended S3 secrets are scoped to their transaction
# group: [transactions]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET s3_base (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# A scan vends credentials into a transaction-scoped secret named '__proto_ic_...'.
query I
SELECT count(*) FROM lake.default.test_table;
----
5

# That scoped secret must be dropped when the (auto-commit) scan transaction commits.
query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# A failed auto-commit statement must also discard credentials created while binding the scan.
statement error
SELECT CAST(name AS INTEGER) FROM lake.default.test_table;
----
Could not convert string

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# Inside an explicit transaction, a scan vends the scoped secret and it must exist while the txn is open.
statement ok
BEGIN;

query I
SELECT count(*) FROM lake.default.test_table;
----
5

# Transaction-scoped credentials must not be visible to another connection.
query I con1
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%' AND storage = 'transaction';
----
1

# Scanning again within the transaction must not accumulate another secret.
query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%' AND storage = 'transaction';
----
1

# The scoped secret must be dropped on explicit commit.
statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# Rollback must have the same cleanup behavior.
statement ok
BEGIN;

query I
SELECT count(*) FROM lake.default.test_table;
----
5

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0
