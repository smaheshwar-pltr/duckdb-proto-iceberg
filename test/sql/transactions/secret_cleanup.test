# name: test/sql/transactions/secret_cleanup.test
# description: Scoped S3 secrets are dropped when their transaction ends
# group: [transactions]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET s3_base (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

# A scan vends credentials into a temporary scoped secret named '__proto_ic_...'.
query I
SELECT count(*) FROM lake.default.test_table;
----
5

# It's dropped when the autocommit transaction commits.
query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# In an explicit transaction, the secret lasts until the transaction ends.
statement ok
BEGIN;

query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
1

# Scanning again in the transaction reuses the secret.
query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
1

# It's also dropped on rollback.
statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# Two catalogs on the same endpoint each create their own secret for the same table.
statement ok
ATTACH '' AS lake2 (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

statement ok
BEGIN;

query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM lake2.default.test_table;
----
5

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
2

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

# The secret is also dropped when the system catalog, used first here, commits after the Iceberg catalog.
statement ok
BEGIN;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0

query I
SELECT count(*) FROM lake.default.test_table;
----
5

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '%proto_ic%';
----
0
