# name: test/sql/transactions/table_caching.test
# description: Each table is loaded once per transaction
# group: [transactions]

require-env ICEBERG_SERVER_AVAILABLE

require proto_iceberg

require httpfs

require parquet

statement ok
CREATE SECRET (TYPE S3, ENDPOINT 'localhost:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH '' AS lake (TYPE ICEBERG, ENDPOINT 'http://localhost:8181');

statement ok
CALL enable_logging(level := 'debug');

# Each table is loaded once per transaction, however often it's used

statement ok
CALL truncate_duckdb_logs();

statement ok
BEGIN;

query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM lake.default.orders;
----
6

query I
SELECT count(*) FROM lake.default.test_table;
----
5

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_logs() WHERE message LIKE '%LoadTable%test_table%';
----
1

query I
SELECT count(*) FROM duckdb_logs() WHERE message LIKE '%LoadTable%orders%';
----
1

# Each autocommit query loads the table anew

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM lake.default.test_table;
----
5

query I
SELECT count(*) FROM duckdb_logs() WHERE message LIKE '%LoadTable%test_table%';
----
2

# Listed before first use in one transaction: loaded once, then listed and scanned as the full table

statement ok
CALL truncate_duckdb_logs();

statement ok
BEGIN;

query TT
SELECT column_names, column_types FROM (SHOW ALL TABLES)
WHERE database = 'lake' AND schema = 'default' AND name = 'test_table';
----
[__]	[UNKNOWN]

query I
SELECT count(*) FROM lake.default.test_table;
----
5

query TT
SELECT column_names, column_types FROM (SHOW ALL TABLES)
WHERE database = 'lake' AND schema = 'default' AND name = 'test_table';
----
[id, name, value]	[INTEGER, VARCHAR, DOUBLE]

query I
SELECT sum(id) FROM lake.default.test_table;
----
15

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_logs() WHERE message LIKE '%LoadTable%test_table%';
----
1
